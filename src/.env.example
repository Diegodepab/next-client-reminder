# Google Sheets Configuration (via Apps Script)
# See docs/googleDataSheet/explicacion.md for setup instructions
GOOGLE_PRIVATE_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Telegram Configuration (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Gmail Configuration (Optional)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com

# Cron Security (Optional but recommended)
CRON_SECRET=your-random-secret-string
